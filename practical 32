import java.util.LinkedList;

public class GenericSearch {

    public static <T> boolean searchElement(LinkedList<T> list, T element) {
        return list.contains(element);
    }

    public static void main(String[] args) {

        LinkedList<Integer> rollNumbers = new LinkedList<>();
        rollNumbers.add(101);
        rollNumbers.add(102);
        rollNumbers.add(103);
        rollNumbers.add(104);

        System.out.println("Searching in roll numbers:");
        System.out.println("Is 102 present? " + searchElement(rollNumbers, 102));
        System.out.println("Is 110 present? " + searchElement(rollNumbers, 110));

        LinkedList<String> names = new LinkedList<>();
        names.add("Rahul");
        names.add("Amit");
        names.add("Neha");
        names.add("Priya");

        System.out.println("\nSearching in names:");
        System.out.println("Is Amit present? " + searchElement(names, "Amit"));
        System.out.println("Is John present? " + searchElement(names, "John"));
    }
}
